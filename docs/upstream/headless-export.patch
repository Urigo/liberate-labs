+        rej(new Error(method + ': no reply in 30s'));
+      }, 30_000);
+      pending.set(id, {
+        resolve: (v) => { clearTimeout(timer); res(v); },
+        reject: (e) => { clearTimeout(timer); rej(e); },
+      });
+    });
+  };
