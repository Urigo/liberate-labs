diff --git a/scripts/headless-export.mjs b/scripts/headless-export.mjs
new file mode 100644
index 0000000..597238f
--- /dev/null
+++ b/scripts/headless-export.mjs
@@ -0,0 +1,173 @@
+// An export from the terminal, with no extension: the same collector the extension runs (src/core/),
+// driven from Node against a browser this script opens and signs in to, writing the same folder the
+// ZIP would hold. For a member who wants the export on a schedule, or just without a popup.
+//
+//   npm run export                        test results and lab histories into ./maccabi-export-<today>/
+//   npm run export -- --all               every section the extension collects, except that nothing is
+//                                         ordered: the medical file already on the site is taken as it is
+//   npm run export -- --steps visits,referrals
+//                                         just those steps (names from STEP_ORDER in src/core/steps.ts)
+//   npm run export -- --out ~/health      the export folder goes under that directory
+//   npm run export -- --keep              leave the browser open at the end
+//
+// The browser and the sign-in are scripts/maccabi-browser.mjs: a real Chrome, Chromium or Edge with a
+// profile outside the repo, so a live session is reused, and the username and password from 1Password
+// references in .env, filled once. The requests themselves are sent from inside the Maccabi Online
+// page, as the extension sends them from the tab: the site's bot protection accepts page requests, and
+// the legacy /online/ services answer only a tab that has their page loaded. So the browser window is
+// real and visible; nothing here is headless in the --headless sense, only in that no one has to click.
+//
+// What the extension's run does and this does not: order the medical file (the one request that changes
+// anything on the account, and what makes Maccabi send an SMS), pause when the tab is hidden (the script
+// keeps the window; leave it be), resume a run across sessions (a rerun into the same folder skips the
+// files it already has, which is the same thing for an export that takes minutes), and build the ZIP (a
+// folder is what the assistants open anyway; zip it yourself if you want one).
+//
+// Nothing here prints a credential or a record: what it reports is step names, counts and problem lines,
+// with the member id written as {mid} as the export's own files write it.
+import { mkdirSync, readFileSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { build } from 'vite';
+import { ACTIVITY_IN_PAGE, folderSink, pageTransport, sessionOf } from './headless-lib.mjs';
+import { START, openBrowser, signIn } from './maccabi-browser.mjs';
+import { root, sleep } from './stage.mjs';
+
+const args = process.argv.slice(2);
+const flag = (name) => args.includes(name);
+const option = (name) => {
+  const i = args.indexOf(name);
+  return i >= 0 ? args[i + 1] : undefined;
+};
+const KEEP = flag('--keep');
+const ALL = flag('--all');
+const STEPS_ARG = option('--steps');
+const OUT = resolve(option('--out') || '.');
+
+/** The site logs the tab out after ~6 min without a click; a mousedown every 2 min keeps it (see keepSessionAlive in tab.ts). */
+const ALIVE_MS = 120_000;
+
+/** The TypeScript sources, bundled for Node: src/cli/index.ts re-exports what this script uses. */
+async function loadCore() {
+  const out = join(root, 'dist-cli');
+  await build({
+    root,
+    configFile: false,
+    logLevel: 'warn',
+    publicDir: false,
+    define: { __DEV_BRIDGE__: 'false' },
+    build: {
+      outDir: out,
+      emptyOutDir: true,
+      minify: false,
+      target: 'es2022',
+      lib: { entry: join(root, 'src/cli/index.ts'), formats: ['es'], fileName: () => 'core.mjs' },
+      rollupOptions: { external: ['fflate'] },
+    },
+  });
+  return import(pathToFileURL(join(out, 'core.mjs')).href);
+}
+
+// ---- the run --------------------------------------------------------------------------------------
+
+/** Navigates and waits until the page's path matches; the token is only issued and renewed on /sonline/. */
+async function goTo(page, url, pathRe) {
+  await page.navigate(url);
+  for (let i = 0; i < 60; i++) {
+    await sleep(500);
+    const path = await page.probe('location.pathname', '');
+    if (pathRe.test(path)) return;
+  }
+  throw new Error('The page did not reach ' + url);
+}
+
+async function main() {
+  const core = await loadCore();
+  const wanted = ALL ? core.STEP_ORDER : STEPS_ARG ? STEPS_ARG.split(',') : ['testResults'];
+  for (const s of wanted) if (!core.STEP_ORDER.includes(s)) throw new Error('No such step: ' + s + '. Steps: ' + core.STEP_ORDER.join(', '));
+  const legacy = wanted.filter((s) => core.LEGACY_STEPS.includes(s));
+  const rest = wanted.filter((s) => !core.LEGACY_STEPS.includes(s));
+
+  const dir = join(OUT, core.exportName(Date.now()));
+  mkdirSync(dir, { recursive: true });
+  const sink = folderSink(core, dir, JSON.parse(readFileSync(join(root, 'package.json'), 'utf8')).version);
+
+  const page = await openBrowser({ startUrl: START, keep: KEEP });
+  await sleep(2000);
+  await signIn(page);
+  let session = await sessionOf(page, core);
+  if (!session) throw new Error('Signed in, but no session token on the page.');
+
+  const startedAt = new Date().toISOString();
+  let lastDetail = '';
+  const deps = {
+    transport: pageTransport(page),
+    sink,
+    html: core.domHtmlParser(await htmlParser()),
+    clock: { now: () => Date.now(), sleep },
+    progress: (ev) => {
+      if (ev.detail && ev.detail !== lastDetail) {
+        lastDetail = ev.detail;
+        process.stdout.write('  ' + ev.detail + (ev.items ? ' (' + ev.items.total + ')' : '') + '\n');
+      }
+    },
+  };
+  const c = new core.Collector(deps, session);
+  const ctx = core.newCtx();
+  const alive = setInterval(() => page.probe(ACTIVITY_IN_PAGE, undefined), ALIVE_MS);
+
+  const run = async (name) => {
+    const t = Date.now();
+    const before = sink.problems.length;
+    console.log(name);
+    await core.runStep(c, ctx, name);
+    const filed = sink.problems.length - before;
+    console.log(`  done in ${((Date.now() - t) / 1000).toFixed(1)} s` + (filed ? `, ${filed} problem${filed > 1 ? 's' : ''}` : ''));
+  };
+  try {
+    if (legacy.length) {
+      // The legacy services answer only after a /online/ page has loaded in the session, and the requests go from it.
+      await goTo(page, core.SUMMARY_PAGE, /^\/online\//i);
+      for (const name of legacy) await run(name);
+      await goTo(page, START, /^\/sonline\//i);
+      session = (await sessionOf(page, core)) || session;
+      c.session = session;
+    }
+    for (const name of rest) await run(name);
+  } catch (e) {
+    if (e && e.sessionEnded) console.error(e.message);
+    else throw e;
+    process.exitCode = 1;
+  } finally {
+    clearInterval(alive);
+  }
+
+  const { files, errors } = sink.writeRootFiles(startedAt);
+  const width = Math.max(0, ...Object.keys(files).map((k) => k.length));
+  for (const [folder, n] of Object.entries(files).sort()) console.log(`  ${folder.padEnd(width)}  ${String(n).padStart(4)} files`);
+  for (const p of sink.problems) console.log('  problem: ' + p.where + ': ' + p.what);
+  console.log(`${errors.length ? errors.length + ' problems; ' : ''}export in ${dir}`);
+}
+
+/** happy-dom's DOMParser, for the two legacy HTML tables; a dev dependency, so only loaded when a legacy step runs. */
+async function htmlParser() {
+  try {
+    const { Window } = await import('happy-dom');
+    return new Window().DOMParser;
+  } catch {
+    return class {
+      parseFromString() {
+        throw new Error('happy-dom is not installed (npm install), which the legacy steps need to parse HTML');
+      }
+    };
+  }
+}
+
+// Exiting kills the browser (see openBrowser), unless --keep asked for it to stay.
+main().then(
+  () => process.exit(),
+  (e) => {
+    console.error(e.message);
+    process.exit(1);
+  },
+);
diff --git a/scripts/headless-lib.d.mts b/scripts/headless-lib.d.mts
new file mode 100644
index 0000000..95ad77e
--- /dev/null
+++ b/scripts/headless-lib.d.mts
@@ -0,0 +1,28 @@
+// Types of headless-lib.mjs for the test that imports it; the script itself is plain JavaScript.
+import type { HttpRequest, HttpResponse, Problem, Session, Sink } from '../src/core';
+
+export const STALL_MS: number;
+export const MAX_BYTES: number;
+export const FETCH_IN_PAGE: string;
+export const XHR_IN_PAGE: string;
+export const ACTIVITY_IN_PAGE: string;
+export const SNAPSHOT: string;
+
+export interface Page {
+  evaluate(expression: string): Promise<unknown>;
+  probe(expression: string, fallback: unknown): Promise<unknown>;
+}
+
+export function pageTransport(page: Page): {
+  fetch(req: HttpRequest): Promise<HttpResponse>;
+  xhr(req: HttpRequest): Promise<{ status: number; text: string }>;
+  pagePath(): Promise<string>;
+};
+
+export function sessionOf(page: Page, core: unknown, tries?: number): Promise<Session | null>;
+
+export interface FolderSink extends Sink {
+  problems: Problem[];
+  writeRootFiles(startedAt: string): { files: Record<string, number>; errors: unknown[] };
+}
+export function folderSink(core: unknown, dir: string, version: string): FolderSink;
diff --git a/scripts/headless-lib.mjs b/scripts/headless-lib.mjs
new file mode 100644
index 0000000..8caef96
--- /dev/null
+++ b/scripts/headless-lib.mjs
@@ -0,0 +1,189 @@
+// The two seams scripts/headless-export.mjs puts under the collector (src/core/): the Maccabi Online
+// page as its Transport, and a folder as its Sink. Kept apart from the script so the tests can run them
+// without a browser. `core` is the bundled src/cli/index.ts (or, in the tests, the sources themselves).
+import { createHash } from 'node:crypto';
+import { existsSync, mkdirSync, readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+
+const ORIGIN = 'https://online.maccabi4u.co.il';
+
+// A value written into code that a page evaluates (as in maccabi-browser.mjs).
+const UNSAFE = { '<': '\\u003C', '>': '\\u003E', '/': '\\u002F', '\u2028': '\\u2028', '\u2029': '\\u2029' };
+const lit = (value) => JSON.stringify(value).replace(/[<>/\u2028\u2029]/g, (c) => UNSAFE[c]);
+
+/** Seconds without a byte after which a request is given up, and the largest body brought back (as in the extension). */
+export const STALL_MS = 60_000;
+export const MAX_BYTES = 32 * 1024 * 1024;
+
+// ---- the page as a Transport ------------------------------------------------------------------
+
+/** Runs in the page: fetchInPage from src/extension/background/tab.ts, as source for Runtime.evaluate. */
+export const FETCH_IN_PAGE = `async (req, stallMs, maxBytes) => {
+  const abort = new AbortController();
+  let timer;
+  const alive = () => { clearTimeout(timer); timer = setTimeout(() => abort.abort(), stallMs); };
+  try {
+    alive();
+    const r = await fetch(req.url, { method: req.method, headers: req.headers, body: req.body, credentials: 'include', redirect: req.redirect || 'follow', signal: abort.signal });
+    const head = { ok: true, status: r.status, redirected: r.type === 'opaqueredirect', contentType: r.headers.get('content-type') || '', retryAfter: r.headers.get('retry-after') || undefined, url: r.url };
+    if (Number(r.headers.get('content-length')) > maxBytes) { abort.abort(); return { ...head, tooLarge: true }; }
+    const parts = [];
+    let length = 0;
+    if (r.body) {
+      const reader = r.body.getReader();
+      for (;;) {
+        alive();
+        const { done, value } = await reader.read();
+        if (done) break;
+        length += value.length;
+        if (length > maxBytes) { abort.abort(); return { ...head, tooLarge: true }; }
+        parts.push(value);
+      }
+    }
+    const buf = new Uint8Array(length);
+    let at = 0;
+    for (const p of parts) { buf.set(p, at); at += p.length; }
+    let bin = '';
+    for (let i = 0; i < buf.length; i += 0x8000) bin += String.fromCharCode.apply(null, Array.from(buf.subarray(i, i + 0x8000)));
+    return { ...head, b64: btoa(bin) };
+  } catch (e) {
+    return { ok: false, error: abort.signal.aborted ? 'Maccabi Healthcare Services sent nothing for ' + stallMs / 1000 + ' s' : (e && e.message) || String(e) };
+  } finally {
+    clearTimeout(timer);
+  }
+}`;
+
+/** Runs in the page: xhrInPage from tab.ts. Never rejects: status 0 on error. */
+export const XHR_IN_PAGE = `(req) => new Promise((resolve) => {
+  const x = new XMLHttpRequest();
+  x.open(req.method, req.url, true);
+  const h = req.headers || {};
+  for (const k in h) x.setRequestHeader(k, h[k]);
+  x.onload = () => resolve({ status: x.status, text: x.responseText });
+  x.onerror = () => resolve({ status: 0, text: '' });
+  x.send(req.body);
+})`;
+
+/** Runs in the page: activityInPage from tab.ts, the click the site's idle timers listen for. */
+export const ACTIVITY_IN_PAGE = `(() => {
+  document.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
+  if (typeof resetActive !== 'function') return;
+  const counting = window.countDownStarted === true;
+  if (counting) window.countDownStarted = false;
+  resetActive();
+  if (counting && typeof closedialog === 'function') closedialog();
+})()`;
+
+export const SNAPSHOT = `({ host: location.hostname, path: location.pathname,
+  cookieMid: (document.cookie.match(/cookie_sessionId_0_(\\d+)/) || [])[1] || null,
+  jwt: sessionStorage.getItem('token') })`;
+
+export function pageTransport(page) {
+  return {
+    async fetch(req) {
+      const url = new URL(req.url, ORIGIN).toString();
+      const r = await page.evaluate(`(${FETCH_IN_PAGE})(${lit({ ...req, url })}, ${STALL_MS}, ${MAX_BYTES})`);
+      if (!r.ok) throw new Error(r.error);
+      const { b64, ...head } = r;
+      return { ...head, bytes: b64 ? new Uint8Array(Buffer.from(b64, 'base64')) : new Uint8Array() };
+    },
+    xhr(req) {
+      return page.evaluate(`(${XHR_IN_PAGE})(${lit({ ...req, url: new URL(req.url, ORIGIN).toString() })})`);
+    },
+    pagePath: () => page.evaluate('location.pathname'),
+  };
+}
+
+/** The member's session as the page holds it (token and member id), or null when nobody is signed in. */
+export async function sessionOf(page, core, tries = 30) {
+  for (let i = 0; i < tries; i++) {
+    const s = await page.probe(SNAPSHOT, null);
+    if (s && s.host === new URL(ORIGIN).hostname && s.jwt) {
+      const { mid, gender } = core.sessionFrom(s.cookieMid, s.jwt);
+      if (mid) return { mid, jwt: s.jwt, gender };
+    }
+    await new Promise((r) => setTimeout(r, 500));
+  }
+  return null;
+}
+
+// ---- a folder as a Sink -------------------------------------------------------------------------
+
+/** The export folder, with the extension's write rules: JSON rewritten only when changed, documents kept. */
+export function folderSink(core, dir, version) {
+  const shas = new Map(); // sha256 -> rel, of the documents already in the folder
+  const aliases = new Map();
+  const problems = [];
+  const sha = (bytes) => createHash('sha256').update(bytes).digest('hex');
+  const walk = (d, rel = '') => {
+    for (const name of existsSync(d) ? readdirSync(d) : []) {
+      const full = join(d, name);
+      const r = rel ? rel + '/' + name : name;
+      if (statSync(full).isDirectory()) walk(full, r);
+      else if (!r.endsWith('.json') && !r.endsWith('.md')) shas.set(sha(readFileSync(full)), r);
+    }
+  };
+  walk(dir);
+  const read = (rel) => (existsSync(join(dir, rel)) ? new Uint8Array(readFileSync(join(dir, rel))) : undefined);
+  const write = (rel, bytes) => {
+    mkdirSync(dirname(join(dir, rel)), { recursive: true });
+    writeFileSync(join(dir, rel), bytes);
+  };
+  return {
+    problems,
+    async exists(rel) {
+      return existsSync(join(dir, rel));
+    },
+    async putJson(rel, obj) {
+      const bad = core.badPath(rel);
+      if (bad) return { error: bad };
+      const result = core.jsonResult(read(rel), obj);
+      if (result !== 'unchanged') write(rel, core.jsonBytes(obj));
+      return { result };
+    },
+    async putBin(rel, bytes, replace) {
+      const bad = core.badPath(rel);
+      if (bad) return { error: bad };
+      const result = core.binResult(read(rel), bytes, replace);
+      if (result === 'written' || result === 'updated') {
+        for (const [s, at] of shas) if (at === rel) shas.delete(s);
+        write(rel, bytes);
+        shas.set(sha(bytes), rel);
+      }
+      return { result };
+    },
+    async findBySha256(s) {
+      return shas.get(s) ?? null;
+    },
+    async putAlias(rel, existing) {
+      aliases.set(rel, existing);
+    },
+    async aliasOf(rel) {
+      return aliases.get(rel) ?? null;
+    },
+    async problem(p) {
+      problems.push(p);
+    },
+    /** The root files the extension's save step writes, from what the folder holds. */
+    writeRootFiles(startedAt) {
+      const files = {};
+      let medicalFile = null;
+      const count = (d, rel = '') => {
+        for (const name of readdirSync(d)) {
+          const full = join(d, name);
+          const r = rel ? rel + '/' + name : name;
+          if (statSync(full).isDirectory()) count(full, r);
+          else if (r.includes('/')) files[r.split('/')[0]] = (files[r.split('/')[0]] || 0) + 1;
+          else if (r.endsWith('_medical-file.pdf') && (!medicalFile || r > medicalFile)) medicalFile = r;
+        }
+      };
+      count(dir);
+      const errors = core.exportErrors(problems);
+      write(core.EXPORT_ERRORS, Buffer.from(JSON.stringify(errors, null, 2) + '\n'));
