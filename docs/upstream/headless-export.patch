+  let target;
+  for (let i = 0; !target; i++) {
+    const { targetInfos } = await send('Target.getTargets');
+    target = targetInfos.find((t) => t.type === 'page' && t.url.startsWith('https://'))
+      || (i > 20 && targetInfos.find((t) => t.type === 'page'));
+    if (!target) await sleep(500);
